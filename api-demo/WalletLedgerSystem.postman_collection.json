{
  "info": {
    "name": "Wallet Ledger System API",
    "description": "Postman collection for the Distributed Wallet Transaction & Ledger System",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1"
    }
  ],
  "item": [
    {
      "name": "Wallets",
      "item": [
        {
          "name": "Create Wallet - Alice",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ownerName\": \"Alice Johnson\",\n  \"initialBalance\": 1000.00,\n  \"currency\": \"USD\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/wallets" }
          }
        },
        {
          "name": "Create Wallet - Bob",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ownerName\": \"Bob Smith\",\n  \"initialBalance\": 500.00,\n  \"currency\": \"USD\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/wallets" }
          }
        },
        {
          "name": "Get All Wallets",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/wallets" }
          }
        },
        {
          "name": "Get Wallet by ID",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/wallets/1" }
          }
        },
        {
          "name": "Get Wallet Ledger",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/wallets/1/ledger" }
          }
        }
      ]
    },
    {
      "name": "Transfers",
      "item": [
        {
          "name": "Transfer Funds (Alice → Bob)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Idempotency-Key", "value": "txn-unique-key-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceWalletId\": 1,\n  \"destinationWalletId\": 2,\n  \"amount\": 250.00,\n  \"description\": \"Payment for services\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/transfers" }
          }
        },
        {
          "name": "Replay Same Idempotency Key (Cached Response)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Idempotency-Key", "value": "txn-unique-key-001" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceWalletId\": 1,\n  \"destinationWalletId\": 2,\n  \"amount\": 250.00,\n  \"description\": \"Payment for services\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/transfers" }
          }
        },
        {
          "name": "Error: Insufficient Balance",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Idempotency-Key", "value": "txn-will-fail-insufficient" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceWalletId\": 1,\n  \"destinationWalletId\": 2,\n  \"amount\": 99999.00,\n  \"description\": \"This will fail\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/transfers" }
          }
        },
        {
          "name": "Error: Self-Transfer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Idempotency-Key", "value": "txn-self-transfer" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceWalletId\": 1,\n  \"destinationWalletId\": 1,\n  \"amount\": 100.00,\n  \"description\": \"Self-transfer should fail\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/transfers" }
          }
        },
        {
          "name": "Error: Missing Idempotency Key",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"sourceWalletId\": 1,\n  \"destinationWalletId\": 2,\n  \"amount\": 50.00\n}"
            },
            "url": { "raw": "{{baseUrl}}/transfers" }
          }
        }
      ]
    }
  ]
}
